server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  location / {
    try_files $uri /index.html;
  }

  # Proxy API requests – API_BASE should include scheme+host (e.g., https://your-api.up.railway.app)
  location /api/ {
    resolver 1.1.1.1 8.8.8.8 valid=30s;
    set $api_base "$API_BASE";
    if ($api_base = "") {
      set $api_base http://backend:5000; # fallback for local compose
    }
    proxy_pass $api_base/api/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}


